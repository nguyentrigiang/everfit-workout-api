# Copy to .env for local development: cp .env.example .env
# Full list with defaults: README, "Environment variables".

# development | production | test (development enables pretty logs)
NODE_ENV=development
# Port the API listens on
PORT=3000
# Postgres connection string (required)
DATABASE_URL=postgresql://everfit:everfit@localhost:5432/everfit
# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=debug

# Optional, Docker Compose. Compose also reads .env, so LOG_LEVEL above applies to the container too.
# POSTGRES_USER=everfit
# POSTGRES_PASSWORD=everfit
# POSTGRES_DB=everfit
# APP_PORT=3000
# DB_PORT=5432

# Optional, scripts and tests
# SEED_CONFIG_PATH=config/exercises.json
# BASE_URL=http://localhost:3000
# PERF_REPORT_PATH=docs/PERFORMANCE.md
# TEST_DATABASE_URL=postgresql://everfit:everfit@localhost:5432/everfit_test
